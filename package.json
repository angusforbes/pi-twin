{
  "name": "pi-twin",
  "version": "0.1.0",
  "description": "Split a live Pi conversation into a twin, then review and merge its handoff",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "herdr",
    "clone",
    "sessions"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  },
  "bin": {
    "pi-twin": "./bin/pi-live-clone.mjs",
    "pi-live-clone": "./bin/pi-live-clone.mjs"
  },
  "files": [
    "src",
    "bin",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:rpc": "node tests/rpc-smoke.mjs",
    "check": "tsc --noEmit && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "jiti": "2.7.0"
  }
}
