+pub enum TwinAction {
+    Clone {
+        public_pane_id: String,
+        /// Session token captured at menu-open; revalidated before dispatch.
+        session_id: String,
+    },
+    Merge {
+        public_pane_id: String,
+        /// Session token captured at menu-open; revalidated before dispatch.
+        session_id: String,
+    },
+}
